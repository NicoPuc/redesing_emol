generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Article {
  id                Int         @id @default(autoincrement())
  category          String
  title             String
  description       String
  subtitle          String
  author            String
  image             String
  publishedAt       String
  publishHour       Int
  publishMinute     Int
  readingMinutes    Int
  baseCommentsCount Int         @default(0)
  dayOffset         Int         @default(0)
  content           String[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  comments          Comment[]
  aiSummary         AiSummary?

  @@index([dayOffset, publishHour, publishMinute])
  @@index([category])
}

model Comment {
  id         Int      @id @default(autoincrement())
  articleId  Int
  authorId   Int
  authorName String
  body       String
  createdAt  DateTime @default(now())
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
}

model AiSummary {
  id        Int      @id @default(autoincrement())
  articleId Int      @unique
  bullets   String[]
  model     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
}
